---
import { Code } from 'astro:components';
import { COPY, GITHUB } from '../data/copy';
import Demos from '../demos/Demos';
import { type Lang, PRODUCTS, type Product } from '../data/products';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = COPY[lang];
const byId = Object.fromEntries(PRODUCTS.map((p) => [p.id, p]));
const colours = (p: Product) => `--c:${p.color};--p:${p.pale};--cd:${p.colorDark};--pd:${p.paleDark}${p.text ? `;--t:${p.text}` : ''}`;
const formatsOf = (p: Product) => (typeof p.formats === 'string' ? p.formats : p.formats[lang]);
const install = (p: Product) => (p.npm ? `npm install ${p.npm.name}` : '');
const FORMATS = ['DOCX', 'XLSX', 'PPTX', 'PDF', 'CSV', 'Markdown', 'HTML'];

// Simple line icons for what the apps have in common.
const ICONS: Record<string, string> = {
  engine: '<circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M4.2 4.2l2.1 2.1M17.7 17.7l2.1 2.1M2 12h3M19 12h3M4.2 19.8l2.1-2.1M17.7 6.3l2.1-2.1"/>',
  file: '<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5M9 13h6M9 17h4"/>',
  server: '<rect x="3" y="4" width="18" height="7" rx="2"/><rect x="3" y="13" width="18" height="7" rx="2"/><path d="M7 7.5h.01M7 16.5h.01"/>',
  people: '<circle cx="9" cy="8" r="3.2"/><path d="M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6"/><circle cx="17" cy="9" r="2.6"/><path d="M15.5 14.2c3 .2 5.5 2.6 5.5 5.8"/>',
  spark: '<path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8z"/><path d="M19 15l.8 2.2L22 18l-2.2.8L19 21l-.8-2.2L16 18l2.2-.8z"/>',
  globe: '<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.7 3.8 5.7 3.8 9s-1.3 6.3-3.8 9c-2.5-2.7-3.8-5.7-3.8-9S9.5 5.7 12 3z"/>',
};
---

<a class="skip" href="#main">{lang === 'es' ? 'Saltar al contenido' : 'Skip to content'}</a>

<header class="top">
  <div class="wrap top-inner">
    <a class="brand" href={lang === 'es' ? '/' : '/en/'} aria-label="Rebo">
      <img src="/favicon.svg" alt="" width="28" height="28" />
      <span>Rebo</span>
    </a>
    <nav class="nav" aria-label={lang === 'es' ? 'Principal' : 'Main'}>
      <a href="#productos">{t.nav.products}</a>
      <a href="#demo">{t.nav.demo}</a>
      <a href="#juntos">{t.nav.together}</a>
      <a href="#codigo">{t.nav.code}</a>
      <a href="#por-que">{t.nav.why}</a>
    </nav>
    <div class="top-actions">
      <a class="lang" href={t.otherLang.href} hreflang={lang === 'es' ? 'en' : 'es'}>{t.otherLang.label}</a>
      <a class="button button-primary button-small" href={GITHUB}>GitHub</a>
    </div>
  </div>
</header>

<main id="main" aria-label="Rebo Suite">
  <!-- Hero -->
  <section class="hero">
    <div class="wrap hero-inner">
      <div class="hero-copy">
        <span class="eyebrow">{t.hero.eyebrow}</span>
        <h1>{t.hero.title[0]}<br /><span class="hero-soft">{t.hero.title[1]}</span></h1>
        <p class="hero-lead">{t.hero.lead}</p>
        <div class="hero-actions">
          <a class="button button-primary" href="#productos">{t.hero.primary}</a>
          <div class="install" data-copy="npm install @rebodocs/react">
            <code><span aria-hidden="true">$ </span>npm install @rebodocs/react</code>
            <button type="button" class="install-copy" data-label={t.hero.copy} data-done={t.hero.copied}>{t.hero.copy}</button>
          </div>
        </div>
      </div>

      <!-- The seven apps, one after another in front; all of it is said again below, so it is not read out. -->
      <div class="hero-art" aria-hidden="true" data-hero>
        <div class="blobs">
          {PRODUCTS.map((p, i) => <span data-product style={`${colours(p)};--i:${i}`} />)}
        </div>
        <div class="window" data-tilt>
          <div class="window-bar"><i></i><i></i><i></i></div>
          <div class="tiles">
            {
              PRODUCTS.map((p, i) => (
                <div class:list={['tile', { on: i === 0 }]} data-product data-tile style={`${colours(p)};--i:${i}`}>
                  <img src={`/logos/${p.id}.svg`} alt="" width="40" height="40" />
                  <strong>{p.name}</strong>
                  <span>{p.kind[lang]}</span>
                </div>
              ))
            }
          </div>
          <div class="captions">
            {
              PRODUCTS.map((p, i) => (
                <p class:list={['caption', { on: i === 0 }]} data-product data-caption style={colours(p)}>
                  <b>{p.name}</b> {p.tagline[lang]}
                </p>
              ))
            }
          </div>
        </div>
      </div>
    </div>

    <div class="wrap strip" data-reveal>
      <span>{t.strip}</span>
      <ul>{FORMATS.map((f) => <li>{f}</li>)}</ul>
    </div>
  </section>

  <!-- Products -->
  <section class="section" id="productos">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <span class="eyebrow">{t.products.eyebrow}</span>
        <h2>{t.products.title}</h2>
        <p>{t.products.lead}</p>
      </div>

      <div class="products">
        {
          PRODUCTS.map((p, i) => (
            <article class="product" data-product data-reveal data-spot style={`${colours(p)};--d:${i % 3}`} id={p.id}>
              <header class="product-head">
                <img src={`/logos/${p.id}.svg`} alt="" width="44" height="44" />
                <div>
                  <h3>{p.name}</h3>
                  <span class="product-kind">{p.kind[lang]}</span>
                </div>
              </header>
              <p class="product-tagline">{p.tagline[lang]}</p>
              <p class="product-text">{p.description[lang]}</p>
              <ul class="product-features">
                {p.features[lang].map((f) => (
                  <li>
                    <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
                      <path d="M3.5 8.5l3 3 6-7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    {f}
                  </li>
                ))}
              </ul>
              <footer class="product-foot">
                <span class="product-formats">{formatsOf(p)}</span>
                {p.npm ? (
                  <a class="badge" href={`https://www.npmjs.com/package/${p.npm.name}`}>
                    npm <b>{p.npm.version}</b>
                  </a>
                ) : (
                  <span class="badge badge-soon">{t.products.soon}</span>
                )}
                <span class="product-links">
                  {p.site && <a href={p.site}>{t.products.site}</a>}
                  {p.repo && <a href={p.repo}>GitHub</a>}
                </span>
              </footer>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Demos -->
  <section class="section section-demo" id="demo">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <span class="eyebrow">{t.demo.eyebrow}</span>
        <h2>{t.demo.title}</h2>
        <p>{t.demo.lead}</p>
      </div>
      <div data-reveal>
        <Demos client:only="react" lang={lang} apps={PRODUCTS.filter((p) => p.npm).map((p) => ({ id: p.id, name: p.name, kind: p.kind[lang], style: colours(p) }))} texts={t.demo} />
      </div>
    </div>
  </section>

  <!-- Together -->
  <section class="section section-tint" id="juntos">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <span class="eyebrow">{t.together.eyebrow}</span>
        <h2>{t.together.title}</h2>
        <p>{t.together.lead}</p>
      </div>

      <div class="links">
        {
          t.together.links.map((link, i) => {
            const to = byId[link.to];
            return (
              <div class="link" data-product data-reveal style={`${colours(to)};--d:${i}`}>
                <div class="link-flow" aria-hidden="true">
                  <div class="link-from">
                    {link.from.map((id) => (
                      <img src={`/logos/${id}.svg`} alt="" width="34" height="34" />
                    ))}
                  </div>
                  <svg class="link-arrow" viewBox="0 0 48 16" width="48" height="16">
                    <path class="link-track" d="M2 8h40" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                    <path class="link-pulse" d="M2 8h40" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" />
                    <path d="M36 3l6 5-6 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  <img class="link-to" src={`/logos/${to.id}.svg`} alt="" width="44" height="44" />
                </div>
                <h3>{link.title}</h3>
                <p>{link.text}</p>
              </div>
            );
          })
        }
      </div>
    </div>
  </section>

  <!-- Code -->
  <section class="section" id="codigo">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <span class="eyebrow">{t.code.eyebrow}</span>
        <h2>{t.code.title}</h2>
        <p>{t.code.lead}</p>
      </div>

      <div class="code" data-tabs data-reveal>
        <div class="code-tabs" role="tablist" aria-label={t.code.tablist}>
          {
            PRODUCTS.map((p, i) => (
              <button
                type="button"
                role="tab"
                id={`tab-${p.id}`}
                aria-controls={`panel-${p.id}`}
                aria-selected={i === 0 ? 'true' : 'false'}
                tabindex={i === 0 ? 0 : -1}
                data-product
                style={colours(p)}
              >
                <img src={`/logos/${p.id}.svg`} alt="" width="20" height="20" />
                {p.name}
              </button>
            ))
          }
        </div>
        {
          PRODUCTS.map((p, i) => (
            <div class="code-panel" role="tabpanel" id={`panel-${p.id}`} aria-labelledby={`tab-${p.id}`} hidden={i !== 0} tabindex="0">
              <div class="code-install">
                {p.npm ? (
                  <code>
                    <span aria-hidden="true">$ </span>
                    {install(p)}
                  </code>
                ) : (
                  <span>{t.products.soon}</span>
                )}
              </div>
              <Code code={p.snippet.code} lang={p.snippet.lang} themes={{ light: 'github-light-default', dark: 'github-dark-default' }} defaultColor={false} />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Why -->
  <section class="section section-tint" id="por-que">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <span class="eyebrow">{t.why.eyebrow}</span>
        <h2>{t.why.title}</h2>
      </div>
      <div class="why">
        {
          t.why.items.map((item, i) => (
            <div class="why-item" data-reveal style={`--d:${i % 3}`}>
              <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICONS[item.icon]} />
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Call to action -->
  <section class="section">
    <div class="wrap">
      <div class="cta" data-reveal>
        <div class="cta-logos" aria-hidden="true">
          {PRODUCTS.map((p) => <img src={`/logos/${p.id}.svg`} alt="" width="40" height="40" />)}
        </div>
        <h2>{t.cta.title}</h2>
        <p>{t.cta.text}</p>
        <a class="button button-primary" href={GITHUB}>{t.cta.button}</a>
      </div>
    </div>
  </section>
</main>

<footer class="foot">
  <div class="wrap foot-inner">
    <a class="brand" href={lang === 'es' ? '/' : '/en/'}>
      <img src="/favicon.svg" alt="" width="22" height="22" />
      <span>Rebo</span>
    </a>
    <ul class="foot-products">
      {
        PRODUCTS.map((p) => (
          <li>
            <a href={`#${p.id}`}>{p.name}</a>
          </li>
        ))
      }
    </ul>
    <p>© 2026 · {t.footer.made}</p>
  </div>
</footer>

<script>
  // The command to install, copied with its button.
  for (const box of document.querySelectorAll<HTMLElement>('[data-copy]')) {
    const button = box.querySelector<HTMLButtonElement>('button');
    button?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(box.dataset.copy ?? '');
        button.textContent = button.dataset.done ?? '';
        setTimeout(() => (button.textContent = button.dataset.label ?? ''), 1600);
      } catch {
        // No clipboard here: the command stays on the page to be selected.
      }
    });
  }

  // The tabs of the code: a click, or the arrows, Home and End on the tab list.
  for (const root of document.querySelectorAll<HTMLElement>('[data-tabs]')) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const show = (next: HTMLButtonElement, focus: boolean) => {
      for (const tab of tabs) {
        const on = tab === next;
        tab.setAttribute('aria-selected', String(on));
        tab.tabIndex = on ? 0 : -1;
        const panel = document.getElementById(tab.getAttribute('aria-controls') ?? '');
        if (panel) panel.hidden = !on;
      }
      if (focus) next.focus();
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => show(tab, false));
      tab.addEventListener('keydown', (event) => {
        const to = { ArrowRight: i + 1, ArrowLeft: i - 1, Home: 0, End: tabs.length - 1 }[event.key];
        if (to === undefined) return;
        event.preventDefault();
        show(tabs[(to + tabs.length) % tabs.length], true);
      });
    });
  }

  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const fine = matchMedia('(hover: hover) and (pointer: fine)').matches;

  // What comes in as it is scrolled to, once.
  const reveals = document.querySelectorAll<HTMLElement>('[data-reveal]');
  if (still || !('IntersectionObserver' in window)) reveals.forEach((el) => el.classList.add('in'));
  else {
    const seen = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add('in');
          seen.unobserve(entry.target);
        }
      },
      { rootMargin: '0px 0px -8% 0px' },
    );
    reveals.forEach((el) => seen.observe(el));
  }

  // The header lifts off the page once it is scrolled.
  const top = document.querySelector<HTMLElement>('.top');
  const lift = () => top?.classList.toggle('lifted', scrollY > 8);
  addEventListener('scroll', lift, { passive: true });
  lift();

  // The apps of the hero, one after another in front, with what each is; the one under the pointer stays.
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  if (hero) {
    const tiles = [...hero.querySelectorAll<HTMLElement>('[data-tile]')];
    const captions = [...hero.querySelectorAll<HTMLElement>('[data-caption]')];
    let current = 0;
    let held = false;
    const front = (index: number) => {
      current = index;
      tiles.forEach((tile, i) => tile.classList.toggle('on', i === index));
      captions.forEach((caption, i) => caption.classList.toggle('on', i === index));
    };
    tiles.forEach((tile, i) =>
      tile.addEventListener('pointerenter', () => {
        held = true;
        front(i);
      }),
    );
    hero.addEventListener('pointerleave', () => (held = false));
    if (!still) setInterval(() => !held && !document.hidden && front((current + 1) % tiles.length), 2600);

    // The window leans a little toward the pointer.
    const tilt = hero.querySelector<HTMLElement>('[data-tilt]');
    if (tilt && fine && !still) {
      hero.addEventListener('pointermove', (event) => {
        const box = hero.getBoundingClientRect();
        const x = (event.clientX - box.left) / box.width - 0.5;
        const y = (event.clientY - box.top) / box.height - 0.5;
        tilt.style.setProperty('--ry', `${(x * 7).toFixed(2)}deg`);
        tilt.style.setProperty('--rx', `${(-y * 7).toFixed(2)}deg`);
      });
      hero.addEventListener('pointerleave', () => {
        tilt.style.setProperty('--ry', '0deg');
        tilt.style.setProperty('--rx', '0deg');
      });
    }
  }

  // A light of the app's colour under the pointer, on each product.
  if (fine) {
    for (const card of document.querySelectorAll<HTMLElement>('[data-spot]')) {
      card.addEventListener('pointermove', (event) => {
        const box = card.getBoundingClientRect();
        card.style.setProperty('--mx', `${event.clientX - box.left}px`);
        card.style.setProperty('--my', `${event.clientY - box.top}px`);
      });
    }
  }
</script>

<style>
  /* --- Header ----------------------------------------------------------- */
  .top {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: saturate(1.4) blur(14px);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    border-bottom: 1px solid transparent;
    transition:
      border-color 0.25s ease,
      box-shadow 0.25s ease;
  }
  .top.lifted {
    border-bottom-color: var(--line);
    box-shadow: 0 6px 20px -14px rgba(0, 0, 0, 0.25);
  }
  .top-inner {
    display: flex;
    align-items: center;
    gap: 24px;
    height: 64px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 700;
    font-size: 19px;
    letter-spacing: -0.02em;
    text-decoration: none;
  }
  .nav {
    display: flex;
    gap: 4px;
    margin-left: 16px;
  }
  .nav a {
    padding: 6px 12px;
    border-radius: 999px;
    color: var(--ink-soft);
    font-size: 15px;
    text-decoration: none;
  }
  .nav a:hover {
    background: var(--surface);
    color: var(--ink);
  }
  .top-actions {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-left: auto;
  }
  .lang {
    font-size: 14px;
    color: var(--muted);
    text-decoration: none;
  }
  .lang:hover {
    color: var(--ink);
  }
  .button-small {
    height: 36px;
    padding: 0 16px;
    font-size: 14px;
  }
  @media (max-width: 820px) {
    .nav {
      display: none;
    }
  }

  /* --- Hero ------------------------------------------------------------- */
  .hero {
    padding: 88px 0 40px;
    overflow: hidden;
  }
  .hero-inner {
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    gap: 48px;
    align-items: center;
  }
  .hero h1 {
    font-size: clamp(38px, 5.2vw, 60px);
    letter-spacing: -0.035em;
  }
  .hero-soft {
    color: var(--muted);
  }
  .hero-lead {
    margin-top: 24px;
    max-width: 560px;
    font-size: 19px;
    color: var(--ink-soft);
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin-top: 36px;
  }
  .install {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    height: 44px;
    padding: 0 6px 0 16px;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: var(--card);
    max-width: 100%;
  }
  .install code {
    font-family: var(--mono);
    font-size: 14px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .install code span {
    color: var(--muted);
  }
  .install-copy {
    height: 32px;
    padding: 0 12px;
    border: 0;
    border-radius: 999px;
    background: var(--surface);
    color: var(--ink-soft);
    font: inherit;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
  }
  .install-copy:hover {
    color: var(--ink);
  }

  .hero-art {
    position: relative;
    perspective: 1200px;
  }
  /* Soft lights of the seven colours, drifting behind the window. */
  .blobs {
    position: absolute;
    inset: -12% -10%;
    z-index: 0;
    filter: blur(48px);
    opacity: 0.55;
    pointer-events: none;
  }
  .blobs span {
    position: absolute;
    width: 42%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--pc);
    opacity: 0.28;
    animation: drift 18s ease-in-out infinite alternate;
    animation-delay: calc(var(--i) * -3s);
  }
  .blobs span:nth-child(1) { left: 0; top: 0; }
  .blobs span:nth-child(2) { left: 30%; top: -6%; }
  .blobs span:nth-child(3) { right: 0; top: 4%; }
  .blobs span:nth-child(4) { left: 4%; bottom: 0; }
  .blobs span:nth-child(5) { left: 34%; bottom: -8%; }
  .blobs span:nth-child(6) { right: 2%; bottom: 2%; }
  @keyframes drift {
    to {
      transform: translate(8%, -10%) scale(1.15);
    }
  }
  @media (prefers-color-scheme: dark) {
    .blobs {
      opacity: 0.4;
    }
  }

  .window {
    position: relative;
    z-index: 1;
    border: 1px solid var(--line);
    border-radius: 22px;
    background: var(--card);
    box-shadow: var(--shadow-lift);
    overflow: hidden;
    transform: rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    transition: transform 0.4s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .window-bar {
    display: flex;
    gap: 7px;
    padding: 14px 16px;
    border-bottom: 1px solid var(--line);
    background: var(--surface);
  }
  .window-bar i {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--line-strong);
  }
  .tiles {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
    padding: 22px;
  }
  .tile {
